rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Quy tắc cho bộ sưu tập thẻ (Cards)
    // Cho phép bất kỳ ai cũng có thể đọc danh sách và chi tiết thẻ
    match /cards/{cardId} {
      allow read: if true;
      // Chỉ cho phép người dùng đã đăng nhập (hoặc Admin) mới được ghi/sửa dữ liệu thẻ
      allow write: if request.auth != null;
    }

    // 2. Quy tắc cho thông tin người dùng (Users)
    // Người dùng chỉ có thể đọc/ghi dữ liệu của chính mình
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      // allow create: người dùng vừa đăng ký có thể tạo document của chính mình
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Quy tắc cho ví thẻ người dùng (user_cards)
    match /user_cards/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // 4. Quy tắc cho lịch sử giao dịch (transactions)
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // 5. Quy tắc cho ví cá nhân (user_wallets)
    match /user_wallets/{walletId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Mặc định: Không cho phép truy cập các tài liệu khác nếu không được định nghĩa rõ ràng
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
